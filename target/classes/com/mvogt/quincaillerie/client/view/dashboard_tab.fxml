<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mvogt.quincaillerie.client.controller.DashboardTabController"
      spacing="16">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Tableau de bord" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="actualisationAutoCheckBox" text="Actualisation auto (30s)" selected="true"/>
        <Button text="Actualiser" onAction="#handleActualiser" styleClass="button-outline"/>
    </HBox>
    <HBox spacing="16">
        <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Produits en catalogue" styleClass="stat-title"/>
            <Label fx:id="totalProduitsLabel" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Sous le seuil d'alerte" styleClass="stat-title"/>
            <Label fx:id="sousSeuilLabel" styleClass="stat-value stat-value-warning"/>
        </VBox>
        <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Derniere mise a jour" styleClass="stat-title"/>
            <Label fx:id="derniereMajLabel" styleClass="stat-value"/>
        </VBox>
    </HBox>
    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Inventaire produits" styleClass="card-title"/>
        <TableView fx:id="produitsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colReference" text="Reference" prefWidth="120"/>
                <TableColumn fx:id="colNom" text="Produit" prefWidth="220"/>
                <TableColumn fx:id="colCategorie" text="Categorie" prefWidth="150"/>
                <TableColumn fx:id="colStockActuel" text="Stock actuel" prefWidth="100"/>
                <TableColumn fx:id="colSeuilAlerte" text="Seuil d'alerte" prefWidth="100"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
</VBox>
