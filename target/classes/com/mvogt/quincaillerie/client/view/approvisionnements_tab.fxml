<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mvogt.quincaillerie.client.controller.ApprovisionnementsTabController"
      spacing="16">
    <VBox spacing="10" prefWidth="420" styleClass="card">
        <Label text="Nouvel approvisionnement" styleClass="card-title"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Fournisseur"/>
            <ComboBox fx:id="fournisseurCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Produit"/>
            <ComboBox fx:id="produitCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Qte"/>
            <TextField fx:id="quantiteField" prefWidth="60" text="1"/>
            <Label text="Prix achat unitaire"/>
            <TextField fx:id="prixAchatUnitaireField" prefWidth="90"/>
            <Button text="Ajouter ligne" onAction="#handleAjouterLigne" styleClass="button-outline"/>
        </HBox>
        <TableView fx:id="lignesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colLigneProduit" text="Produit" prefWidth="150"/>
                <TableColumn fx:id="colLigneQuantite" text="Qte" prefWidth="60"/>
                <TableColumn fx:id="colLignePrixUnitaire" text="P.U." prefWidth="80"/>
                <TableColumn fx:id="colLigneSousTotal" text="Sous-total" prefWidth="90"/>
            </columns>
        </TableView>
        <HBox spacing="6">
            <Button text="Retirer la ligne" onAction="#handleRetirerLigne" styleClass="button-danger-outline"/>
            <Button fx:id="validerButton" text="Valider l'approvisionnement" onAction="#handleValider"/>
        </HBox>
        <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
    </VBox>
    <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Historique" styleClass="card-title"/>
            <Button text="Rafraichir" onAction="#handleRafraichirHistorique" styleClass="button-outline"/>
        </HBox>
        <TableView fx:id="historiqueTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colHistoId" text="#" prefWidth="50"/>
                <TableColumn fx:id="colHistoDate" text="Date" prefWidth="150"/>
                <TableColumn fx:id="colHistoFournisseur" text="Fournisseur" prefWidth="150"/>
                <TableColumn fx:id="colHistoGestionnaire" text="Gestionnaire" prefWidth="100"/>
                <TableColumn fx:id="colHistoMontant" text="Montant" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</HBox>
