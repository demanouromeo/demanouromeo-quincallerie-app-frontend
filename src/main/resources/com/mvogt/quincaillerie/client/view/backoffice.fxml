<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mvogt.quincaillerie.client.controller.BackofficeController"
            styleClass="app-root"
            stylesheets="@app.css"
            prefWidth="1200" prefHeight="720">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="210" styleClass="brand-box">
                <Label text="Quincaillerie ETOUD" styleClass="brand-title"/>
            </HBox>
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="12" styleClass="header-box">
                <Label text="Espace de gestion" styleClass="welcome-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="sessionLabel" styleClass="session-pill"/>
                <Button text="Changer mot de passe" onAction="#handleChangerMotDePasse" styleClass="button-outline">
                    <tooltip>
                        <Tooltip text="Changer le mot de passe de mon compte"/>
                    </tooltip>
                </Button>
                <Button text="Deconnexion" onAction="#handleDeconnexion" styleClass="button-danger-outline">
                    <tooltip>
                        <Tooltip text="Se deconnecter et revenir a l'ecran de connexion"/>
                    </tooltip>
                </Button>
            </HBox>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" side="LEFT" tabClosingPolicy="UNAVAILABLE" styleClass="sidebar-tabs">
            <tabs>
                <Tab fx:id="dashboardTab" text="Tableau de bord">
                    <content>
                        <fx:include fx:id="dashboard" source="dashboard_tab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="produitsTab" text="Produits &amp; Stock">
                    <content>
                        <fx:include fx:id="produits" source="produits_tab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="approvisionnementsTab" text="Approvisionnements">
                    <content>
                        <fx:include fx:id="approvisionnements" source="approvisionnements_tab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="fournisseursTab" text="Fournisseurs">
                    <content>
                        <fx:include fx:id="fournisseurs" source="fournisseurs_tab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="categoriesTab" text="Categories">
                    <content>
                        <fx:include fx:id="categories" source="categories_tab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="utilisateursTab" text="Utilisateurs">
                    <content>
                        <fx:include fx:id="utilisateurs" source="utilisateurs_tab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="rapportsTab" text="Rapports">
                    <content>
                        <fx:include fx:id="rapports" source="rapports_tab.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
