<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mvogt.quincaillerie.client.controller.ParametresTabController"
      spacing="10" prefWidth="420" styleClass="card">
    <Label text="Parametres du magasin" styleClass="card-title"/>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="Nom" prefWidth="90"/>
        <TextField fx:id="nomField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="Domaine d'activite" prefWidth="90" wrapText="true"/>
        <TextField fx:id="domaineField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="Ville" prefWidth="90"/>
        <TextField fx:id="villeField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="Telephone" prefWidth="90"/>
        <TextField fx:id="telephoneField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="Email" prefWidth="90"/>
        <TextField fx:id="emailField" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Button text="Enregistrer" onAction="#handleEnregistrer">
        <tooltip>
            <Tooltip text="Enregistrer les parametres du magasin"/>
        </tooltip>
    </Button>
    <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
</VBox>
