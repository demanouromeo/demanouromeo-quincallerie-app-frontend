<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mvogt.quincaillerie.client.controller.RapportsTabController"
      spacing="16">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Rapports" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Rafraichir" onAction="#handleRafraichir" styleClass="button-outline">
            <tooltip>
                <Tooltip text="Recalculer les rapports a partir des dernieres ventes"/>
            </tooltip>
        </Button>
    </HBox>
    <HBox spacing="16">
        <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Ventes du jour" styleClass="stat-title"/>
            <Label fx:id="ventesJourLabel" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Ventes de la semaine" styleClass="stat-title"/>
            <Label fx:id="ventesSemaineLabel" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Ventes du mois" styleClass="stat-title"/>
            <Label fx:id="ventesMoisLabel" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Produits sous seuil d'alerte" styleClass="stat-title"/>
            <Label fx:id="alertesLabel" styleClass="stat-value stat-value-warning"/>
        </VBox>
    </HBox>
    <HBox spacing="16">
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS" prefHeight="260">
            <Label text="Ventes des 14 derniers jours" styleClass="card-title"/>
            <LineChart fx:id="ventesTendanceChart" styleClass="ventes-tendance-chart"
                       legendVisible="false" animated="false" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis fx:id="tendanceAxis" label="Date"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="tendanceValueAxis" label="Montant (FCFA)"/>
                </yAxis>
            </LineChart>
        </VBox>
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS" prefHeight="260">
            <Label text="Top produits vendus" styleClass="card-title"/>
            <BarChart fx:id="topProduitsChart" styleClass="top-produits-chart"
                      legendVisible="true" animated="false" VBox.vgrow="ALWAYS">
                <xAxis>
                    <NumberAxis fx:id="topProduitsValueAxis" label="Quantite vendue"/>
                </xAxis>
                <yAxis>
                    <CategoryAxis fx:id="topProduitsAxis" label="Produit"/>
                </yAxis>
            </BarChart>
        </VBox>
    </HBox>
    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Produits les plus vendus (toutes periodes)" styleClass="card-title"/>
        <TableView fx:id="topProduitsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProduitNom" text="Produit" prefWidth="250"/>
                <TableColumn fx:id="colQuantiteVendue" text="Quantite vendue" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
</VBox>
