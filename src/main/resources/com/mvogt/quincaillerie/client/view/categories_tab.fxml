<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mvogt.quincaillerie.client.controller.CategoriesTabController"
      spacing="16">
    <VBox spacing="10" prefWidth="320" styleClass="card">
        <Label text="Categories" styleClass="card-title"/>
        <TableView fx:id="categoriesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="290"/>
            </columns>
        </TableView>
    </VBox>
    <VBox spacing="10" prefWidth="280" styleClass="card">
        <Label text="Fiche categorie" styleClass="card-title"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Nom"/>
            <TextField fx:id="nomField" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="6">
            <Button text="Nouveau" onAction="#handleNouveau" styleClass="button-outline">
                <tooltip>
                    <Tooltip text="Vider la fiche pour creer une nouvelle categorie"/>
                </tooltip>
            </Button>
            <Button text="Enregistrer" onAction="#handleEnregistrer">
                <tooltip>
                    <Tooltip text="Enregistrer la categorie"/>
                </tooltip>
            </Button>
            <Button text="Supprimer" onAction="#handleSupprimer" styleClass="button-danger-outline">
                <tooltip>
                    <Tooltip text="Supprimer la categorie selectionnee"/>
                </tooltip>
            </Button>
        </HBox>
        <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
    </VBox>
</HBox>
